<%- include('../partials/header') %>
<article class="route-detail" id="trip-details">
    <p id="trip-loading">Loading trip details...</p>
    <p id="trip-error" hidden></p>
</article>

<template id="trip-details-template">
    <div class="route-header"><div class="route-header-content"><h1 class="route-name" data-field="name"></h1><p class="route-description" data-field="description"></p><div class="highlights" data-field="highlights"></div></div><div class="route-image"><img data-field="image"></div></div>
    <div class="route-info">
        <div class="info-grid"><div class="info-item"><span class="info-label">Region</span><span class="info-value" data-field="region"></span></div><div class="info-item"><span class="info-label">Duration</span><span class="info-value" data-field="duration"></span></div><div class="info-item"><span class="info-label">Distance</span><span class="info-value" data-field="distance"></span></div><div class="info-item"><span class="info-label">Best Season</span><span class="info-value" data-field="season"></span></div></div>
        <div class="route-stations"><h2>Trip</h2><div class="stations"><div class="station"><span class="station-label">Start</span><span class="station-name" data-field="start"></span></div><div class="station"><span class="station-label">End</span><span class="station-name" data-field="end"></span></div></div></div>
        <div class="route-operating"><h2>Operating Schedule</h2><div class="months-grid" data-field="months"></div></div>
        <div class="route-schedules"><h2>Available Schedules</h2><div class="schedules-grid" data-field="schedules"></div></div>
    </div>
</template>
<template id="schedule-template"><div class="schedule-card"><div class="schedule-times"><span class="time-value" data-field="departure"></span><span class="time-arrow">&#8594;</span><span class="time-value" data-field="arrival"></span></div><div class="schedule-days" data-field="days"></div><a class="book-btn" data-field="link">Book Now</a></div></template>
<%- include('../partials/footer') %>

<%- include('../partials/header') %>
<h1><%= title %></h1>

<div id="filters">
    <label for="region-filter">Search by Region:</label>
    <select id="region-filter"><option value="all">All Regions</option></select>
    <label for="season-filter">Search by Season:</label>
    <select id="season-filter"><option value="all">Any Season</option></select>
</div>

<p id="trips-loading">Loading trips...</p>
<p id="trips-error" hidden></p>
<div class="routes-grid" id="trips-list"></div>

<template id="trip-card-template">
    <article class="route-card">
        <div class="route-header"><h2 class="route-name" data-field="name"></h2><span class="route-region" data-field="region"></span></div>
        <div class="station-info"><div class="station"><div class="station-type">From:</div><div class="station-name" data-field="start"></div></div><div class="route-arrow">&#8594;</div><div class="station"><div class="station-type">To:</div><div class="station-name" data-field="end"></div></div></div>
        <div class="route-details"><div class="detail-item"><span class="detail-label">Duration:</span> <span data-field="duration"></span></div><div class="detail-item"><span class="detail-label">Distance:</span> <span data-field="distance"></span></div><div class="detail-item"><span data-field="season"></span></div></div>
        <p class="route-description" data-field="description"></p>
        <div class="highlights" data-field="highlights"></div>
        <div class="route-actions"><a class="view-details-btn" data-field="link">View Details &amp; Book &#8594;</a></div>
    </article>
</template>

<%- include('../partials/footer') %>
